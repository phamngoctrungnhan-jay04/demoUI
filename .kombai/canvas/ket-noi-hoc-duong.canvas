      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19490/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/ket-noi-hoc-duong.canvas\", nodeId: \"node_bf2a53caa5cf\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" data-kid=\"1\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" data-kid=\"2\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n<script src=\"https://unpkg.com/lucide@latest\"></script>\n<div class=\"w-full min-h-[1220px] bg-[#F7F5EF] font-['Be_Vietnam_Pro'] flex flex-col items-center py-14 px-6\" data-name=\"tạo hồ sơ page\" data-kid=\"3\">\n  <div class=\"flex items-center gap-2 mb-8\" data-name=\"logo lockup\" data-kid=\"3-1\">\n    <div class=\"w-9 h-9 rounded-md bg-[#D4FF3F] flex items-center justify-center text-[#151821] font-['Space_Grotesk'] font-bold text-lg\" data-kid=\"3-1-1\">K</div>\n    <span class=\"text-[#151821] font-['Space_Grotesk'] font-semibold text-lg\" data-kid=\"3-1-2\">Kết Nối Học Đường</span>\n  </div>\n  <div class=\"w-full max-w-[780px] bg-white rounded-lg border-2 border-[#151821] p-10\" data-name=\"onboarding wizard card\" data-kid=\"3-2\">\n    <div class=\"flex items-center justify-between mb-2\" data-name=\"wizard header row\" data-kid=\"3-2-1\">\n      <h2 class=\"font-['Space_Grotesk'] font-bold text-[26px] text-[#151821]\" data-name=\"wizard heading\" data-kid=\"3-2-1-1\">Hồ sơ của bạn, gu của bạn</h2>\n      <span class=\"-rotate-3 bg-[#151821] text-[#D4FF3F] text-[11px] font-bold uppercase tracking-wide px-3 py-1 rounded-full\" data-name=\"rebel sticker badge\" data-kid=\"3-2-1-2\">1 phút thôi</span>\n    </div>\n    <p class=\"text-[#151821]/60 text-[15px] mb-8\" data-name=\"wizard subheading\" data-kid=\"3-2-2\">Không cần hoàn hảo — chỉ cần đúng là bạn.</p>\n    <div class=\"flex gap-2 mb-10\" data-name=\"step progress bar\" data-kid=\"3-2-3\">\n      <div class=\"h-2 flex-1 rounded-full bg-[#D4FF3F]\" data-kid=\"3-2-3-1\"></div>\n      <div class=\"h-2 flex-1 rounded-full bg-[#151821]/10\" data-kid=\"3-2-3-2\"></div>\n      <div class=\"h-2 flex-1 rounded-full bg-[#151821]/10\" data-kid=\"3-2-3-3\"></div>\n    </div>\n    <section class=\"mb-10\" data-name=\"section thông tin cơ bản\" data-kid=\"3-2-4\">\n      <h3 class=\"font-['Space_Grotesk'] font-semibold text-[18px] text-[#151821] mb-4\" data-kid=\"3-2-4-1\">Bước 1 · Cơ bản</h3>\n      <div class=\"grid grid-cols-2 gap-4 mb-4\" data-kid=\"3-2-4-2\">\n        <div data-kid=\"3-2-4-2-1\"><label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-kid=\"3-2-4-2-1-1\">Khối</label><input value=\"Khối 10\" class=\"w-full px-3 py-3 rounded-md border-2 border-[#151821] bg-white text-[15px] text-[#151821]\" data-kid=\"3-2-4-2-1-2\"></div>\n        <div data-kid=\"3-2-4-2-2\"><label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-kid=\"3-2-4-2-2-1\">Lớp</label><input value=\"10A3\" class=\"w-full px-3 py-3 rounded-md border-2 border-[#151821] bg-white text-[15px] text-[#151821]\" data-kid=\"3-2-4-2-2-2\"></div>\n      </div>\n      <label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-kid=\"3-2-4-3\">Giới thiệu ngắn</label>\n      <textarea rows=\"2\" placeholder=\"Mình thích...\" class=\"w-full px-3 py-3 rounded-md border-2 border-[#151821] bg-white text-[15px] text-[#151821] resize-none placeholder:text-[#151821]/30\" data-kid=\"3-2-4-4\"></textarea>\n    </section>\n    <section class=\"mb-10\" data-name=\"section chọn avatar\" data-kid=\"3-2-5\">\n      <h3 class=\"font-['Space_Grotesk'] font-semibold text-[18px] text-[#151821] mb-1\" data-kid=\"3-2-5-1\">Bước 2 · Chọn avatar</h3>\n      <p class=\"text-[13px] text-[#151821]/55 mb-4\" data-kid=\"3-2-5-2\">Một icon riêng đại diện cho bạn — không dùng ảnh thật.</p>\n      <div class=\"grid grid-cols-6 gap-3 max-w-[460px]\" data-name=\"avatar options grid\" data-kid=\"3-2-5-3\">\n        <button class=\"relative aspect-square rounded-full bg-[#D4FF3F] border-2 border-[#151821] flex items-center justify-center\" data-name=\"avatar selected\" data-kid=\"3-2-5-3-1\"><i data-lucide=\"rocket\" class=\"w-6 h-6 text-[#151821]\" data-kid=\"3-2-5-3-1-1\"></i><span class=\"absolute -top-1.5 -right-1.5 -rotate-12 w-5 h-5 rounded-full bg-[#FF2E93] border-2 border-[#151821] flex items-center justify-center\" data-kid=\"3-2-5-3-1-2\"><i data-lucide=\"check\" class=\"w-3 h-3 text-white\" data-kid=\"3-2-5-3-1-2-1\"></i></span></button>\n        <button class=\"aspect-square rounded-full border-2 border-[#151821]/25 flex items-center justify-center\" data-kid=\"3-2-5-3-2\"><i data-lucide=\"bird\" class=\"w-6 h-6 text-[#151821]/70\" data-kid=\"3-2-5-3-2-1\"></i></button>\n        <button class=\"aspect-square rounded-full border-2 border-[#151821]/25 flex items-center justify-center\" data-kid=\"3-2-5-3-3\"><i data-lucide=\"cat\" class=\"w-6 h-6 text-[#151821]/70\" data-kid=\"3-2-5-3-3-1\"></i></button>\n        <button class=\"aspect-square rounded-full border-2 border-[#151821]/25 flex items-center justify-center\" data-kid=\"3-2-5-3-4\"><i data-lucide=\"gamepad-2\" class=\"w-6 h-6 text-[#151821]/70\" data-kid=\"3-2-5-3-4-1\"></i></button>\n        <button class=\"aspect-square rounded-full border-2 border-[#151821]/25 flex items-center justify-center\" data-kid=\"3-2-5-3-5\"><i data-lucide=\"paintbrush\" class=\"w-6 h-6 text-[#151821]/70\" data-kid=\"3-2-5-3-5-1\"></i></button>\n        <button class=\"aspect-square rounded-full border-2 border-[#151821]/25 flex items-center justify-center\" data-kid=\"3-2-5-3-6\"><i data-lucide=\"music\" class=\"w-6 h-6 text-[#151821]/70\" data-kid=\"3-2-5-3-6-1\"></i></button>\n      </div>\n    </section>\n    <section class=\"mb-10\" data-name=\"section sở thích\" data-kid=\"3-2-6\">\n      <h3 class=\"font-['Space_Grotesk'] font-semibold text-[18px] text-[#151821] mb-1\" data-kid=\"3-2-6-1\">Bước 3 · Sở thích, môn học & CLB</h3>\n      <p class=\"text-[13px] text-[#151821]/55 mb-4\" data-kid=\"3-2-6-2\">Chọn nhiều tag — càng nhiều, càng dễ tìm bạn chung sở thích.</p>\n      <div class=\"flex flex-wrap gap-2.5\" data-name=\"interest chips group\" data-kid=\"3-2-6-3\">\n        <span class=\"rotate-1 px-4 py-2 rounded-full bg-[#FF2E93] text-white text-[14px] font-semibold border-2 border-[#151821] flex items-center gap-1.5\" data-kid=\"3-2-6-3-1\"><i data-lucide=\"check\" class=\"w-3.5 h-3.5\" data-kid=\"3-2-6-3-1-1\"></i>Bóng đá</span>\n        <span class=\"px-4 py-2 rounded-full border-2 border-[#151821]/25 text-[#151821] text-[14px]\" data-kid=\"3-2-6-3-2\">Vẽ</span>\n        <span class=\"px-4 py-2 rounded-full border-2 border-[#151821]/25 text-[#151821] text-[14px]\" data-kid=\"3-2-6-3-3\">Toán học</span>\n        <span class=\"-rotate-1 px-4 py-2 rounded-full bg-[#FF2E93] text-white text-[14px] font-semibold border-2 border-[#151821] flex items-center gap-1.5\" data-kid=\"3-2-6-3-4\"><i data-lucide=\"check\" class=\"w-3.5 h-3.5\" data-kid=\"3-2-6-3-4-1\"></i>CLB Âm nhạc</span>\n        <span class=\"px-4 py-2 rounded-full border-2 border-[#151821]/25 text-[#151821] text-[14px]\" data-kid=\"3-2-6-3-5\">Đọc sách</span>\n        <span class=\"rotate-1 px-4 py-2 rounded-full bg-[#FF2E93] text-white text-[14px] font-semibold border-2 border-[#151821] flex items-center gap-1.5\" data-kid=\"3-2-6-3-6\"><i data-lucide=\"check\" class=\"w-3.5 h-3.5\" data-kid=\"3-2-6-3-6-1\"></i>Lập trình</span>\n      </div>\n    </section>\n    <button class=\"w-full py-3.5 rounded-md bg-[#D4FF3F] text-[#151821] font-['Space_Grotesk'] font-bold text-[16px] border-2 border-[#151821]\" data-name=\"hoàn tất submit button\" data-kid=\"3-2-7\">Hoàn tất tạo hồ sơ</button>\n  </div>\n</div>\n<script>lucide.createIcons();</script>",
