      "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" data-kid=\"1\">\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" data-kid=\"2\">\n<div class=\"w-full min-h-[1020px] flex bg-[#F7F5EF] font-['Be_Vietnam_Pro']\" data-name=\"đăng ký page\" data-kid=\"3\">\n  <div class=\"relative w-[600px] shrink-0 bg-[#151821] overflow-hidden\" data-name=\"brand rebel panel\" data-kid=\"3-1\">\n    <div class=\"absolute inset-0\" style=\"background-image: radial-gradient(circle, rgba(212,255,63,0.14) 1.5px, transparent 1.5px); background-size: 18px 18px;\" data-name=\"halftone dot texture\" data-kid=\"3-1-1\"></div>\n    <div class=\"absolute -right-16 top-20 w-72 h-72 bg-[#2FF3E0] rounded-full opacity-20 blur-3xl\" data-name=\"cyan glow blob\" data-kid=\"3-1-2\"></div>\n    <div class=\"relative h-full flex flex-col justify-between p-12\" data-name=\"brand panel content\" data-kid=\"3-1-3\">\n      <div class=\"flex items-center justify-between\" data-name=\"top row\" data-kid=\"3-1-3-1\">\n        <div class=\"flex items-center gap-2\" data-name=\"logo lockup\" data-kid=\"3-1-3-1-1\">\n          <div class=\"w-9 h-9 rounded-md bg-[#D4FF3F] flex items-center justify-center text-[#151821] font-['Space_Grotesk'] font-bold text-lg\" data-kid=\"3-1-3-1-1-1\">K</div>\n          <span class=\"text-white font-['Space_Grotesk'] font-semibold text-lg\" data-kid=\"3-1-3-1-1-2\">Kết Nối Học Đường</span>\n        </div>\n        <span class=\"-rotate-6 border border-dashed border-[#2FF3E0] text-[#2FF3E0] text-[11px] font-semibold uppercase tracking-wide px-3 py-1 rounded-full\" data-name=\"rebel sticker badge\" data-kid=\"3-1-3-1-2\">Thành viên mới</span>\n      </div>\n      <div data-name=\"brand copy block\" data-kid=\"3-1-3-2\">\n        <h1 class=\"font-['Space_Grotesk'] font-bold text-[36px] leading-[1.15] text-white mb-5 max-w-[440px]\" data-name=\"brand panel headline\" data-kid=\"3-1-3-2-1\">Bắt đầu bằng <span class=\"underline decoration-[#D4FF3F] decoration-[8px] underline-offset-[3px]\" data-kid=\"3-1-3-2-1-1\">phiên bản thật</span> của bạn.</h1>\n        <p class=\"text-white/70 text-[15px] leading-relaxed max-w-[400px]\" data-name=\"brand panel subtext\" data-kid=\"3-1-3-2-2\">Tạo tài khoản bằng mã học sinh — không cần ảnh thật, không cần giả vờ.</p>\n      </div>\n      <div class=\"flex gap-8 pt-5 border-t border-white/15\" data-name=\"stats row\" data-kid=\"3-1-3-3\">\n        <div data-name=\"stat block students\" data-kid=\"3-1-3-3-1\"><p class=\"font-['Space_Grotesk'] font-bold text-[24px] text-[#D4FF3F]\" data-kid=\"3-1-3-3-1-1\">1.240+</p><p class=\"text-[11px] text-white/50 uppercase tracking-wide\" data-kid=\"3-1-3-3-1-2\">Học sinh</p></div>\n        <div data-name=\"stat block clubs\" data-kid=\"3-1-3-3-2\"><p class=\"font-['Space_Grotesk'] font-bold text-[24px] text-[#2FF3E0]\" data-kid=\"3-1-3-3-2-1\">45+</p><p class=\"text-[11px] text-white/50 uppercase tracking-wide\" data-kid=\"3-1-3-3-2-2\">CLB & Nhóm</p></div>\n        <div data-name=\"stat block events\" data-kid=\"3-1-3-3-3\"><p class=\"font-['Space_Grotesk'] font-bold text-[24px] text-[#FF2E93]\" data-kid=\"3-1-3-3-3-1\">120+</p><p class=\"text-[11px] text-white/50 uppercase tracking-wide\" data-kid=\"3-1-3-3-3-2\">Sự kiện/năm</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"flex-1 flex items-center justify-center px-16 py-14\" data-name=\"form panel\" data-kid=\"3-2\">\n    <div class=\"w-full max-w-[400px]\" data-name=\"register form container\" data-kid=\"3-2-1\">\n      <h2 class=\"font-['Space_Grotesk'] font-bold text-[28px] text-[#151821] mb-2\" data-name=\"form heading\" data-kid=\"3-2-1-1\">Đăng ký</h2>\n      <p class=\"text-[#151821]/60 text-[15px] mb-7\" data-name=\"form subheading\" data-kid=\"3-2-1-2\">Điền thông tin để tạo tài khoản mới.</p>\n      <label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-name=\"fullname label\" data-kid=\"3-2-1-3\">Họ và tên</label>\n      <input type=\"text\" placeholder=\"Nguyễn Văn A\" class=\"w-full px-3 py-3 mb-4 rounded-md border-2 border-[#151821] bg-white text-[15px] text-[#151821] outline-none focus:border-[#FF2E93] placeholder:text-[#151821]/25\" data-name=\"fullname input\" data-kid=\"3-2-1-4\"/>\n      <label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-name=\"student code label\" data-kid=\"3-2-1-5\">Mã học sinh</label>\n      <div class=\"flex items-stretch mb-4 rounded-md overflow-hidden border-2 border-[#151821] bg-white focus-within:border-[#FF2E93]\" data-name=\"student code input group\" data-kid=\"3-2-1-6\">\n        <span class=\"flex items-center px-3 bg-[#FF2E93] text-white font-['Space_Grotesk'] font-bold text-[15px]\" data-name=\"VS prefix badge\" data-kid=\"3-2-1-6-1\">VS</span>\n        <input type=\"text\" placeholder=\"000000\" maxlength=\"6\" class=\"flex-1 px-3 py-3 text-[15px] text-[#151821] outline-none tabular-nums tracking-wider placeholder:text-[#151821]/25\" data-name=\"student code number input\" data-kid=\"3-2-1-6-2\"/>\n      </div>\n      <label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-name=\"password label\" data-kid=\"3-2-1-7\">Mật khẩu</label>\n      <input type=\"password\" placeholder=\"Tạo mật khẩu\" class=\"w-full px-3 py-3 mb-4 rounded-md border-2 border-[#151821] bg-white text-[15px] text-[#151821] outline-none focus:border-[#FF2E93] placeholder:text-[#151821]/25\" data-name=\"password input\" data-kid=\"3-2-1-8\"/>\n      <label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-name=\"confirm password label\" data-kid=\"3-2-1-9\">Xác nhận mật khẩu</label>\n      <input type=\"password\" placeholder=\"Nhập lại mật khẩu\" class=\"w-full px-3 py-3 mb-5 rounded-md border-2 border-[#151821] bg-white text-[15px] text-[#151821] outline-none focus:border-[#FF2E93] placeholder:text-[#151821]/25\" data-name=\"confirm password input\" data-kid=\"3-2-1-10\"/>\n      <label class=\"flex items-start gap-2.5 mb-6 cursor-pointer\" data-name=\"terms checkbox row\" data-kid=\"3-2-1-11\">\n        <input type=\"checkbox\" class=\"mt-0.5 w-4 h-4 accent-[#FF2E93]\" data-name=\"terms checkbox input\" data-kid=\"3-2-1-11-1\"/>\n        <span class=\"text-[13px] text-[#151821]/70\" data-kid=\"3-2-1-11-2\">Tôi đồng ý với <a href=\"#\" class=\"font-semibold text-[#151821]\" data-kid=\"3-2-1-11-2-1\">điều khoản sử dụng</a>.</span>\n      </label>\n      <button class=\"w-full py-3.5 rounded-md bg-[#D4FF3F] text-[#151821] font-['Space_Grotesk'] font-bold text-[16px] mb-6 border-2 border-[#151821]\" data-name=\"register submit button\" data-kid=\"3-2-1-12\">Đăng ký</button>\n      <p class=\"text-center text-[14px] text-[#151821]/60\" data-name=\"login prompt text\" data-kid=\"3-2-1-13\">Đã có tài khoản? <a href=\"#\" class=\"font-semibold text-[#FF2E93]\" data-name=\"login now link\" data-kid=\"3-2-1-13-1\">Đăng nhập</a></p>\n    </div>\n  </div>\n</div>",
