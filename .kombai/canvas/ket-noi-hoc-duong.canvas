'] bg-[#F7F5EF]\" data-name=\"landing page\" data-kid=\"3\">\n\n  <section class=\"relative overflow-hidden bg-[#151821] pt-10 pb-24 px-16\" data-name=\"hero section\" data-kid=\"3-1\">\n    <div class=\"absolute inset-0\" style=\"background-image: radial-gradient(circle, rgba(212,255,63,0.14) 1.5px, transparent 1.5px); background-size: 18px 18px;\" data-name=\"halftone texture\" data-kid=\"3-1-1\"></div>\n    <div class=\"absolute -right-24 top-10 w-96 h-96 bg-[#FF2E93] rounded-full opacity-20 blur-3xl\" data-name=\"magenta glow\" data-kid=\"3-1-2\"></div>\n    <div class=\"absolute -left-20 bottom-0 w-72 h-72 bg-[#2FF3E0] rounded-full opacity-15 blur-3xl\" data-name=\"cyan glow\" data-kid=\"3-1-3\"></div>\n\n    <div class=\"relative flex items-center justify-between mb-20\" data-name=\"nav row\" data-kid=\"3-1-4\">\n      <div class=\"flex items-center gap-2\" data-name=\"logo lockup\" data-kid=\"3-1-4-1\">\n        <div class=\"w-9 h-9 rounded-md bg-[#D4FF3F] flex items-center justify-center text-[#151821] font-['Space_Grotesk'] font-bold text-lg\" data-kid=\"3-1-4-1-1\">K</div>\n        <span class=\"text-white font-['Space_Grotesk'] font-semibold text-lg\" data-kid=\"3-1-4-1-2\">Kết Nối Học Đường</span>\n      </div>\n      <div class=\"flex items-center gap-8 text-white/70 text-[14px] font-medium\" data-name=\"nav links\" data-kid=\"3-1-4-2\">\n        <span data-kid=\"3-1-4-2-1\">Cách hoạt động</span><span data-kid=\"3-1-4-2-2\">Cộng đồng</span><span data-kid=\"3-1-4-2-3\">Cho giáo viên</span>\n      </div>\n      <button class=\"px-5 py-2.5 rounded-md bg-[#D4FF3F] text-[#151821] font-['Space_Grotesk'] font-bold text-[14px] border-2 border-[#151821]\" data-name=\"nav login button\" data-kid=\"3-1-4-3\">Đăng nhập</button>\n    </div>\n\n    <div class=\"relative flex items-center gap-10\" data-name=\"hero content row\" data-kid=\"3-1-5\">\n      <div class=\"flex-1 max-w-[600px]\" data-name=\"hero copy\" data-kid=\"3-1-5-1\">\n        <span class=\"hero-badge -rotate-6 inline-block border border-dashed border-[#D4FF3F] text-[#D4FF3F] text-[11px] font-semibold uppercase tracking-wide px-3 py-1 rounded-full mb-6\" data-name=\"rebel sticker badge\" data-kid=\"3-1-5-1-1\">Phá vỡ sự ngại ngùng</span>\n        <h1 class=\"font-['Space_Grotesk'] font-bold text-[52px] leading-[1.1] text-white mb-6\" data-name=\"hero headline\" data-kid=\"3-1-5-1-2\">Phá <span class=\"underline decoration-[#FF2E93] decoration-[10px] underline-offset-[4px]\" data-kid=\"3-1-5-1-2-1\">khoảng cách</span>. Không phá <span class=\"underline decoration-[#D4FF3F] decoration-[10px] underline-offset-[4px]\" data-kid=\"3-1-5-1-2-2\">quy tắc</span>.</h1>\n        <p class=\"text-white/70 text-[17px] leading-relaxed mb-8 max-w-[480px]\" data-name=\"hero subtext\" data-kid=\"3-1-5-1-3\">Sân trường số của Vinschool Grand Park — nơi bạn tìm đúng hội, đúng gu, đúng bạn. Không cần ngại, không cần giả vờ.</p>\n        <div class=\"flex items-center gap-4 mb-10\" data-name=\"hero cta row\" data-kid=\"3-1-5-1-4\">\n          <button class=\"px-7 py-3.5 rounded-md bg-[#D4FF3F] text-[#151821] font-['Space_Grotesk'] font-bold text-[16px] border-2 border-[#151821]\" data-name=\"primary cta button\" data-kid=\"3-1-5-1-4-1\">Vào sân trường →</button>\n          <button class=\"px-7 py-3.5 rounded-md bg-transparent text-white font-['Space_Grotesk'] font-semibold text-[16px] border-2 border-white/40\" data-name=\"secondary cta button\" data-kid=\"3-1-5-1-4-2\">Xem cách hoạt động</button>\n        </div>\n        <div class=\"flex items-center gap-6 text-white/50 text-[13px] font-semibold uppercase tracking-wide\" data-name=\"hero trust row\" data-kid=\"3-1-5-1-5\">\n          <span data-kid=\"3-1-5-1-5-1\"><span class=\"text-[#D4FF3F] font-['Space_Grotesk'] text-[16px] mr-1\" data-kid=\"3-1-5-1-5-1-1\">1.240+</span>Học sinh</span>\n          <span class=\"w-1 h-1 rounded-full bg-white/30\" data-kid=\"3-1-5-1-5-2\"></span>\n          <span data-kid=\"3-1-5-1-5-3\"><span class=\"text-[#2FF3E0] font-['Space_Grotesk'] text-[16px] mr-1\" data-kid=\"3-1-5-1-5-3-1\">45+</span>CLB & Nhóm</span>\n          <span class=\"w-1 h-1 rounded-full bg-white/30\" data-kid=\"3-1-5-1-5-4\"></span>\n          <span data-kid=\"3-1-5-1-5-5\"><span class=\"text-[#FF2E93] font-['Space_Grotesk'] text-[16px] mr-1\" data-kid=\"3-1-5-1-5-5-1\">120+</span>Sự kiện/năm</span>\n        </div>\n      </div>\n\n      <div class=\"flex-1 flex items-center justify-center\" data-name=\"hero mascot wrap\" data-kid=\"3-1-5-2\">\n        <svg id=\"mascotJump\" viewBox=\"0 0 320 360\" class=\"w-[340px] h-auto\" data-name=\"chibi mascot breaking through burst illustration\" data-kid=\"3-1-5-2-1\">\n          <rect x=\"60\" y=\"60\" width=\"200\" height=\"200\" fill=\"#D4FF3F\" transform=\"rotate(15 160 160)\" opacity=\"0.95\" />\n          <rect x=\"60\" y=\"60\" width=\"200\" height=\"200\" fill=\"#FF2E93\" transform=\"rotate(60 160 160)\" opacity=\"0.85\" />\n          <ellipse cx=\"118\" cy=\"312\" rx=\"22\" ry=\"13\" fill=\"#2FF3E0\" transform=\"rotate(-18 118 312)\" />\n          <ellipse cx=\"202\" cy=\"312\" rx=\"22\" ry=\"13\" fill=\"#2FF3E0\" transform=\"rotate(18 202 312)\" />\n          <rect x=\"108\" y=\"252\" width=\"28\" height=\"58\" rx=\"14\" fill=\"#151821\" transform=\"rotate(-18 122 252)\" />\n          <rect x=\"184\" y=\"252\" width=\"28\" height=\"58\" rx=\"14\" fill=\"#151821\" transform=\"rotate(18 198 252)\" />\n          <rect x=\"68\" y=\"168\" width=\"28\" height=\"72\" rx=\"14\" fill=\"#FF2E93\" transform=\"rotate(-42 82 168)\" />\n          <rect x=\"224\" y=\"168\" width=\"28\" height=\"72\" rx=\"14\" fill=\"#FF2E93\" transform=\"rotate(42 238 168)\" />\n          <circle cx=\"58\" cy=\"128\" r=\"13\" fill=\"#FFD9B0\" />\n          <circle cx=\"262\" cy=\"128\" r=\"13\" fill=\"#FFD9B0\" />\n          <rect x=\"108\" y=\"172\" width=\"104\" height=\"92\" rx=\"30\" fill=\"#FF2E93\" />\n          <rect x=\"108\" y=\"208\" width=\"104\" height=\"14\" fill=\"#D4FF3F\" />\n          <circle cx=\"160\" cy=\"108\" r=\"58\" fill=\"#FFD9B0\" />\n          <path d=\"M104 92 Q 160 40 216 92 Q 210 60 160 55 Q 110 60 104 92 Z\" fill=\"#151821\" />\n          <path d=\"M96 90 L 78 60 L 108 82 Z\" fill=\"#D4FF3F\" />\n          <path d=\"M224 90 L 242 60 L 212 82 Z\" fill=\"#2FF3E0\" />\n          <circle cx=\"140\" cy=\"104\" r=\"7\" fill=\"#151821\" /><circle cx=\"142\" cy=\"101\" r=\"2\" fill=\"#ffffff\" />\n          <circle cx=\"180\" cy=\"104\" r=\"7\" fill=\"#151821\" /><circle cx=\"182\" cy=\"101\" r=\"2\" fill=\"#ffffff\" />\n          <ellipse cx=\"126\" cy=\"124\" rx=\"10\" ry=\"6\" fill=\"#FF2E93\" opacity=\"0.45\" />\n          <ellipse cx=\"194\" cy=\"124\" rx=\"10\" ry=\"6\" fill=\"#FF2E93\" opacity=\"0.45\" />\n          <path d=\"M138 132 Q 160 148 182 132\" stroke=\"#151821\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" />\n        </svg>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"relative py-24 px-16 bg-[#F7F5EF]\" data-name=\"manifesto section\" data-kid=\"3-2\">\n    <span class=\"manifesto-sticker absolute left-[8%] top-[18%] -rotate-6 bg-white border-2 border-[#151821] rounded-lg px-4 py-2 text-[13px] font-['Space_Grotesk'] font-bold text-[#151821]\" data-name=\"manifesto sticker students\" data-kid=\"3-2-1\">1.240+ học sinh</span>\n      <span class=\"manifesto-sticker absolute right-[10%] top-[10%] rotate-3 bg-[#D4FF3F] border-2 border-[#151821] rounded-lg px-4 py-2 text-[13px] font-['Space_Grotesk'] font-bold text-[#151821]\" data-name=\"manifesto sticker clubs\" data-kid=\"3-2-2\">45+ CLB & nhóm</span>\n      <span class=\"manifesto-sticker absolute right-[14%] bottom-[8%] -rotate-3 bg-[#FF2E93] border-2 border-[#151821] rounded-lg px-4 py-2 text-[13px] font-['Space_Grotesk'] font-bold text-white\" data-name=\"manifesto sticker free\" data-kid=\"3-2-3\">0đ phí sử dụng</span>\n    <p class=\"relative max-w-[760px] mx-auto text-center font-['Space_Grotesk'] font-semibold text-[32px] leading-[1.4] text-[#151821]\" data-name=\"manifesto statement\" data-kid=\"3-2-4\">\n      Không phải app quản lý. Không phải mạng xã hội <span class=\"text-[#FF2E93]\" data-kid=\"3-2-4-1\">sến súc</span>. Đây là sân trường số — nơi bạn được là <span class=\"underline decoration-[#D4FF3F] decoration-[8px] underline-offset-[2px]\" data-kid=\"3-2-4-2\">chính mình</span>, đầy đủ màu sắc, không cần rập khuôn theo ai cả.\n    </p>\n  </section>\n\n  <section class=\"relative bg-[#151821] py-10\" data-name=\"marquee interest section\" data-kid=\"3-3\">\n    <p class=\"text-center text-[12px] font-['Space_Grotesk'] font-semibold text-[#D4FF3F] uppercase tracking-wider mb-6\" data-name=\"marquee eyebrow\" data-kid=\"3-3-1\">Sở thích của cả sân trường</p>\n    <div class=\"marquee-viewport\" data-name=\"interest marquee viewport\" data-kid=\"3-3-2\">\n      <div class=\"marquee-track\" data-name=\"interest marquee track\" data-kid=\"3-3-2-1\">\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#D4FF3F] text-[#D4FF3F] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-1\">Bóng đá</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#FF2E93] text-[#FF2E93] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-2\">Vẽ</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#2FF3E0] text-[#2FF3E0] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-3\">Lập trình</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#D4FF3F] text-[#D4FF3F] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-4\">CLB Âm nhạc</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#FF2E93] text-[#FF2E93] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-5\">Đọc sách</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#2FF3E0] text-[#2FF3E0] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-6\">Nhảy</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#D4FF3F] text-[#D4FF3F] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-7\">Toán học</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#FF2E93] text-[#FF2E93] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-8\">Nhiếp ảnh</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#2FF3E0] text-[#2FF3E0] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-9\">Cầu lông</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#D4FF3F] text-[#D4FF3F] text-[14px] font-semibold shrink-0\" data-kid=\"3-3-2-1-10\">Kịch</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#FF2E93] text-[#FF2E93] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-11\">Bóng đá</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#2FF3E0] text-[#2FF3E0] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-12\">Vẽ</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#D4FF3F] text-[#D4FF3F] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-13\">Lập trình</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#FF2E93] text-[#FF2E93] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-14\">CLB Âm nhạc</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#2FF3E0] text-[#2FF3E0] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-15\">Đọc sách</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#D4FF3F] text-[#D4FF3F] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-16\">Nhảy</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#FF2E93] text-[#FF2E93] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-17\">Toán học</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#2FF3E0] text-[#2FF3E0] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-18\">Nhiếp ảnh</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#D4FF3F] text-[#D4FF3F] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-19\">Cầu lông</span>\n        <span class=\"tag-pill px-5 py-2.5 rounded-full border-2 border-[#FF2E93] text-[#FF2E93] text-[14px] font-semibold shrink-0\" aria-hidden=\"true\" data-kid=\"3-3-2-1-20\">Kịch</span>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"relative py-28 px-16 bg-[#F7F5EF]\" data-name=\"how it works section\" data-kid=\"3-4\">\n    <span class=\"flex items-center gap-1.5 justify-center text-[11px] font-['Space_Grotesk'] font-semibold text-[#151821] uppercase tracking-wider mb-16\" data-name=\"how it works eyebrow\" data-kid=\"3-4-1\"><span class=\"w-2 h-2 bg-[#FF2E93]\" data-kid=\"3-4-1-1\"></span>Cách hoạt động</span>\n    <div class=\"flex items-start justify-between max-w-[1100px] mx-auto gap-6\" data-name=\"how it works steps row\" data-kid=\"3-4-2\">\n      <div class=\"step-card w-[300px] mt-0\" data-name=\"step 1 card\" data-kid=\"3-4-2-1\">\n        <div class=\"w-14 h-14 rounded-full bg-[#D4FF3F] border-2 border-[#151821] flex items-center justify-center mb-5\" data-kid=\"3-4-2-1-1\"><i data-lucide=\"user-plus\" class=\"w-6 h-6 text-[#151821]\" data-kid=\"3-4-2-1-1-1\"></i></div>\n        <p class=\"font-['Space_Grotesk'] font-bold text-[13px] text-[#FF2E93] mb-2\" data-kid=\"3-4-2-1-2\">BƯỚC 01</p>\n        <h3 class=\"font-['Space_Grotesk'] font-bold text-[20px] text-[#151821] mb-2\" data-kid=\"3-4-2-1-3\">Tạo hồ sơ, chọn avatar</h3>\n        <p class=\"text-[#151821]/60 text-[14px] leading-relaxed\" data-kid=\"3-4-2-1-4\">Không cần ảnh thật — chọn icon đại diện riêng, kể câu chuyện của bạn bằng tag sở thích.</p>\n      </div>\n      <div class=\"step-card w-[300px] mt-16\" data-name=\"step 2 card\" data-kid=\"3-4-2-2\">\n        <div class=\"w-14 h-14 rounded-full bg-[#2FF3E0] border-2 border-[#151821] flex items-center justify-center mb-5\" data-kid=\"3-4-2-2-1\"><i data-lucide=\"sparkles\" class=\"w-6 h-6 text-[#151821]\" data-kid=\"3-4-2-2-1-1\"></i></div>\n        <p class=\"font-['Space_Grotesk'] font-bold text-[13px] text-[#FF2E93] mb-2\" data-kid=\"3-4-2-2-2\">BƯỚC 02</p>\n        <h3 class=\"font-['Space_Grotesk'] font-bold text-[20px] text-[#151821] mb-2\" data-kid=\"3-4-2-2-3\">Khám phá gợi ý đúng gu</h3>\n        <p class=\"text-[#151821]/60 text-[14px] leading-relaxed\" data-kid=\"3-4-2-2-4\">Trang chủ gợi ý bạn cùng sở thích, kèm câu hỏi phá băng để mở đầu chuyện dễ hơn.</p>\n      </div>\n      <div class=\"step-card w-[300px] mt-0\" data-name=\"step 3 card\" data-kid=\"3-4-2-3\">\n        <div class=\"w-14 h-14 rounded-full bg-[#FF2E93] border-2 border-[#151821] flex items-center justify-center mb-5\" data-kid=\"3-4-2-3-1\"><i data-lucide=\"messages-square\" class=\"w-6 h-6 text-white\" data-kid=\"3-4-2-3-1-1\"></i></div>\n        <p class=\"font-['Space_Grotesk'] font-bold text-[13px] text-[#FF2E93] mb-2\" data-kid=\"3-4-2-3-2\">BƯỚC 03</p>\n        <h3 class=\"font-['Space_Grotesk'] font-bold text-[20px] text-[#151821] mb-2\" data-kid=\"3-4-2-3-3\">Nhắn tin, tham gia nhóm & sự kiện</h3>\n        <p class=\"text-[#151821]/60 text-[14px] leading-relaxed\" data-kid=\"3-4-2-3-4\">Chat 1-1, gửi thiệp mời sự kiện ngay trong khung chat, tham gia nhóm học theo môn.</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"relative py-28 px-16 bg-[#151821] overflow-hidden\" data-name=\"testimonial section\" data-kid=\"3-5\">\n    <div class=\"absolute inset-0\" style=\"background-image: radial-gradient(circle, rgba(212,255,63,0.1) 1.5px, transparent 1.5px); background-size: 18px 18px;\" data-kid=\"3-5-1\"></div>\n    <div class=\"relative max-w-[560px] mx-auto rotate-[-2deg] bg-[#F7F5EF] border-2 border-[#151821] rounded-md p-10 shadow-[8px_8px_0px_0px_#FF2E93]\" data-name=\"sticky note testimonial card\" data-kid=\"3-5-2\">\n      <div class=\"absolute -top-4 left-10 w-24 h-8 bg-[#D4FF3F]/80 border border-[#151821] rotate-[-4deg]\" data-name=\"washi tape\" data-kid=\"3-5-2-1\"></div>\n      <p class=\"font-['Space_Grotesk'] font-semibold text-[22px] leading-relaxed text-[#151821] mb-6\" data-name=\"testimonial quote\" data-kid=\"3-5-2-2\">“Mình vốn rất ngại làm quen, nhưng nhờ tag CLB Nhạc mà quen được cả nhóm bạn mới toanh. Không ai hỏi điểm số, chỉ hỏi bạn thích nghe nhạc gì thôi.”</p>\n      <p class=\"text-[14px] font-semibold text-[#FF2E93]\" data-name=\"testimonial author\" data-kid=\"3-5-2-3\">Minh Châu · Lớp 9A2</p>\n    </div>\n  </section>\n\n  <section class=\"relative py-28 px-16 bg-[#F7F5EF]\" data-name=\"bento features section\" data-kid=\"3-6\">\n    <span class=\"flex items-center gap-1.5 justify-center text-[11px] font-['Space_Grotesk'] font-semibold text-[#151821] uppercase tracking-wider mb-14\" data-name=\"bento eyebrow\" data-kid=\"3-6-1\"><span class=\"w-2 h-2 bg-[#2FF3E0]\" data-kid=\"3-6-1-1\"></span>Mọi thứ trong một sân trường</span>\n    <div class=\"grid grid-cols-3 grid-rows-2 gap-5 max-w-[1100px] mx-auto h-[520px]\" data-name=\"bento grid\" data-kid=\"3-6-2\">\n      <div class=\"bento-item row-span-2 col-span-1 bg-[#151821] rounded-lg border-2 border-[#151821] p-8 flex flex-col justify-between\" data-name=\"bento item study groups\" data-kid=\"3-6-2-1\">\n        <div class=\"w-12 h-12 rounded-full bg-[#D4FF3F] flex items-center justify-center\" data-kid=\"3-6-2-1-1\"><i data-lucide=\"book-open\" class=\"w-6 h-6 text-[#151821]\" data-kid=\"3-6-2-1-1-1\"></i></div>\n        <div data-kid=\"3-6-2-1-2\"><h3 class=\"font-['Space_Grotesk'] font-bold text-[22px] text-white mb-2\" data-kid=\"3-6-2-1-2-1\">Nhóm học tập</h3><p class=\"text-white/60 text-[14px] leading-relaxed\" data-kid=\"3-6-2-1-2-2\">Hỏi-đáp theo môn, lập nhóm ôn bài cùng bạn cùng lớp hay khác lớp.</p></div>\n      </div>\n      <div class=\"bento-item col-span-1 bg-[#FF2E93] rounded-lg border-2 border-[#151821] p-7 flex flex-col justify-between\" data-name=\"bento item events\" data-kid=\"3-6-2-2\">\n        <i data-lucide=\"calendar-days\" class=\"w-6 h-6 text-white\" data-kid=\"3-6-2-2-1\"></i>\n        <div data-kid=\"3-6-2-2-2\"><h3 class=\"font-['Space_Grotesk'] font-bold text-[18px] text-white mb-1\" data-kid=\"3-6-2-2-2-1\">Sự kiện trường</h3><p class=\"text-white/80 text-[13px]\" data-kid=\"3-6-2-2-2-2\">Đăng ký/huỷ ngay từ bảng tin.</p></div>\n      </div>\n      <div class=\"bento-item col-span-1 bg-[#2FF3E0] rounded-lg border-2 border-[#151821] p-7 flex flex-col justify-between\" data-name=\"bento item messaging\" data-kid=\"3-6-2-3\">\n        <i data-lucide=\"message-circle\" class=\"w-6 h-6 text-[#151821]\" data-kid=\"3-6-2-3-1\"></i>\n        <div data-kid=\"3-6-2-3-2\"><h3 class=\"font-['Space_Grotesk'] font-bold text-[18px] text-[#151821] mb-1\" data-kid=\"3-6-2-3-2-1\">Nhắn tin realtime</h3><p class=\"text-[#151821]/70 text-[13px]\" data-kid=\"3-6-2-3-2-2\">Gửi cả thiệp mời sự kiện trong chat.</p></div>\n      </div>\n      <div class=\"bento-item col-span-2 bg-white border-2 border-[#151821] rounded-lg p-7 flex items-center gap-6\" data-name=\"bento item avatar system\" data-kid=\"3-6-2-4\">\n        <div class=\"w-14 h-14 rounded-full bg-[#D4FF3F] border-2 border-[#151821] flex items-center justify-center shrink-0\" data-kid=\"3-6-2-4-1\"><i data-lucide=\"smile\" class=\"w-7 h-7 text-[#151821]\" data-kid=\"3-6-2-4-1-1\"></i></div>\n        <div data-kid=\"3-6-2-4-2\"><h3 class=\"font-['Space_Grotesk'] font-bold text-[18px] text-[#151821] mb-1\" data-kid=\"3-6-2-4-2-1\">Avatar tự chọn, không ảnh thật</h3><p class=\"text-[#151821]/60 text-[13px]\" data-kid=\"3-6-2-4-2-2\">An toàn, riêng tư, vẫn đầy cá tính.</p></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"relative overflow-hidden bg-[#151821] py-24 px-16\" data-name=\"final cta section\" data-kid=\"3-7\">\n    <div class=\"absolute inset-0\" style=\"background-image: radial-gradient(circle, rgba(255,46,147,0.14) 1.5px, transparent 1.5px); background-size: 18px 18px;\" data-kid=\"3-7-1\"></div>\n    <div class=\"relative flex items-center justify-between max-w-[1100px] mx-auto\" data-name=\"final cta row\" data-kid=\"3-7-2\">\n      <div class=\"max-w-[480px]\" data-name=\"final cta copy\" data-kid=\"3-7-2-1\">\n        <h2 class=\"font-['Space_Grotesk'] font-bold text-[40px] leading-tight text-white mb-6\" data-name=\"final cta headline\" data-kid=\"3-7-2-1-1\">Sẵn sàng phá băng chưa?</h2>\n        <p class=\"text-white/70 text-[16px] mb-8\" data-name=\"final cta subtext\" data-kid=\"3-7-2-1-2\">Tạo tài khoản bằng mã học sinh — mất chưa tới 1 phút.</p>\n        <button class=\"px-8 py-4 rounded-md bg-[#D4FF3F] text-[#151821] font-['Space_Grotesk'] font-bold text-[17px] border-2 border-white\" data-name=\"final cta button\" data-kid=\"3-7-2-1-3\">Tạo tài khoản ngay →</button>\n      </div>\n      <svg viewBox=\"0 0 320 360\" class=\"w-[280px] h-auto\" data-name=\"chibi mascot waving illustration\" data-kid=\"3-7-2-2\">\n        <circle cx=\"160\" cy=\"200\" r=\"120\" fill=\"#D4FF3F\" opacity=\"0.12\" />\n        <ellipse cx=\"130\" cy=\"312\" rx=\"22\" ry=\"13\" fill=\"#2FF3E0\" />\n        <ellipse cx=\"190\" cy=\"312\" rx=\"22\" ry=\"13\" fill=\"#2FF3E0\" />\n        <rect x=\"118\" y=\"255\" width=\"28\" height=\"58\" rx=\"14\" fill=\"#151821\" />\n        <rect x=\"174\" y=\"255\" width=\"28\" height=\"58\" rx=\"14\" fill=\"#151821\" />\n        <rect x=\"70\" y=\"190\" width=\"26\" height=\"66\" rx=\"13\" fill=\"#FF2E93\" transform=\"rotate(-60 83 190)\" data-name=\"waving arm\" />\n        <rect x=\"214\" y=\"212\" width=\"26\" height=\"58\" rx=\"13\" fill=\"#FF2E93\" transform=\"rotate(12 227 212)\" />\n        <circle cx=\"70\" cy