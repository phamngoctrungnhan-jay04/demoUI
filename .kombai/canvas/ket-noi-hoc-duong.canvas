    "node_bb7656a43c63": {
      "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" data-kid=\"1\">\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" data-kid=\"2\">\n<div class=\"w-full min-h-[940px] flex bg-[#F7F5EF] font-['Be_Vietnam_Pro']\" data-name=\"đăng nhập page\" data-kid=\"3\">\n  <div class=\"relative w-[600px] shrink-0 bg-[#151821] overflow-hidden\" data-name=\"brand rebel panel\" data-kid=\"3-1\">\n    <div class=\"absolute inset-0\" style=\"background-image: radial-gradient(circle, rgba(212,255,63,0.14) 1.5px, transparent 1.5px); background-size: 18px 18px;\" data-name=\"halftone dot texture\" data-kid=\"3-1-1\"></div>\n    <div class=\"absolute -right-16 top-20 w-72 h-72 bg-[#FF2E93] rounded-full opacity-20 blur-3xl\" data-name=\"magenta glow blob\" data-kid=\"3-1-2\"></div>\n    <div class=\"relative h-full flex flex-col justify-between p-12\" data-name=\"brand panel content\" data-kid=\"3-1-3\">\n      <div class=\"flex items-center justify-between\" data-name=\"top row\" data-kid=\"3-1-3-1\">\n        <div class=\"flex items-center gap-2\" data-name=\"logo lockup\" data-kid=\"3-1-3-1-1\">\n          <div class=\"w-9 h-9 rounded-md bg-[#D4FF3F] flex items-center justify-center text-[#151821] font-['Space_Grotesk'] font-bold text-lg\" data-kid=\"3-1-3-1-1-1\">K</div>\n          <span class=\"text-white font-['Space_Grotesk'] font-semibold text-lg\" data-kid=\"3-1-3-1-1-2\">Kết Nối Học Đường</span>\n        </div>\n        <span class=\"-rotate-6 border border-dashed border-[#D4FF3F] text-[#D4FF3F] text-[11px] font-semibold uppercase tracking-wide px-3 py-1 rounded-full\" data-name=\"rebel sticker badge\" data-kid=\"3-1-3-1-2\">Không phải app quản lý</span>\n      </div>\n      <div data-name=\"brand copy block\" data-kid=\"3-1-3-2\">\n        <h1 class=\"font-['Space_Grotesk'] font-bold text-[36px] leading-[1.15] text-white mb-5 max-w-[440px]\" data-name=\"brand panel headline\" data-kid=\"3-1-3-2-1\">Sân trường có <span class=\"underline decoration-[#FF2E93] decoration-[8px] underline-offset-[3px]\" data-kid=\"3-1-3-2-1-1\">gu riêng</span> của bạn.</h1>\n        <p class=\"text-white/70 text-[15px] leading-relaxed max-w-[400px]\" data-name=\"brand panel subtext\" data-kid=\"3-1-3-2-2\">Không rập khuôn, không sến — chỉ là nơi tìm đúng hội, đúng gu, đúng bạn.</p>\n      </div>\n      <div class=\"flex gap-8 pt-5 border-t border-white/15\" data-name=\"stats row\" data-kid=\"3-1-3-3\">\n        <div data-name=\"stat block students\" data-kid=\"3-1-3-3-1\"><p class=\"font-['Space_Grotesk'] font-bold text-[24px] text-[#D4FF3F]\" data-kid=\"3-1-3-3-1-1\">1.240+</p><p class=\"text-[11px] text-white/50 uppercase tracking-wide\" data-kid=\"3-1-3-3-1-2\">Học sinh</p></div>\n        <div data-name=\"stat block clubs\" data-kid=\"3-1-3-3-2\"><p class=\"font-['Space_Grotesk'] font-bold text-[24px] text-[#2FF3E0]\" data-kid=\"3-1-3-3-2-1\">45+</p><p class=\"text-[11px] text-white/50 uppercase tracking-wide\" data-kid=\"3-1-3-3-2-2\">CLB & Nhóm</p></div>\n        <div data-name=\"stat block events\" data-kid=\"3-1-3-3-3\"><p class=\"font-['Space_Grotesk'] font-bold text-[24px] text-[#FF2E93]\" data-kid=\"3-1-3-3-3-1\">120+</p><p class=\"text-[11px] text-white/50 uppercase tracking-wide\" data-kid=\"3-1-3-3-3-2\">Sự kiện/năm</p></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"flex-1 flex items-center justify-center px-16 py-20\" data-name=\"form panel\" data-kid=\"3-2\">\n    <div class=\"w-full max-w-[400px]\" data-name=\"login form container\" data-kid=\"3-2-1\">\n      <h2 class=\"font-['Space_Grotesk'] font-bold text-[28px] text-[#151821] mb-2\" data-name=\"form heading\" data-kid=\"3-2-1-1\">Đăng nhập</h2>\n      <p class=\"text-[#151821]/60 text-[15px] mb-8\" data-name=\"form subheading\" data-kid=\"3-2-1-2\">Nhập mã học sinh và mật khẩu để tiếp tục.</p>\n      <label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-name=\"student code label\" data-kid=\"3-2-1-3\">Mã học sinh</label>\n      <div class=\"flex items-stretch mb-5 rounded-md overflow-hidden border-2 border-[#151821] bg-white focus-within:border-[#FF2E93]\" data-name=\"student code input group\" data-kid=\"3-2-1-4\">\n        <span class=\"flex items-center px-3 bg-[#FF2E93] text-white font-['Space_Grotesk'] font-bold text-[15px]\" data-name=\"VS prefix badge\" data-kid=\"3-2-1-4-1\">VS</span>\n        <input type=\"text\" placeholder=\"000000\" maxlength=\"6\" class=\"flex-1 px-3 py-3 text-[15px] text-[#151821] outline-none tabular-nums tracking-wider placeholder:text-[#151821]/25\" data-name=\"student code number input\" data-kid=\"3-2-1-4-2\"/>\n      </div>\n      <label class=\"block text-[13px] font-semibold text-[#151821] mb-1.5\" data-name=\"password label\" data-kid=\"3-2-1-5\">Mật khẩu</label>\n      <input type=\"password\" placeholder=\"Nhập mật khẩu\" class=\"w-full px-3 py-3 mb-2 rounded-md border-2 border-[#151821] bg-white text-[15px] text-[#151821] outline-none focus:border-[#FF2E93] placeholder:text-[#151821]/25\" data-name=\"password input\" data-kid=\"3-2-1-6\"/>\n      <div class=\"flex justify-end mb-6\" data-kid=\"3-2-1-7\"><a href=\"#\" class=\"text-[13px] font-semibold text-[#151821]/60\" data-name=\"forgot password link\" data-kid=\"3-2-1-7-1\">Quên mật khẩu?</a></div>\n      <button class=\"w-full py-3.5 rounded-md bg-[#D4FF3F] text-[#151821] font-['Space_Grotesk'] font-bold text-[16px] mb-6 border-2 border-[#151821]\" data-name=\"login submit button\" data-kid=\"3-2-1-8\">Đăng nhập</button>\n      <p class=\"text-center text-[14px] text-[#151821]/60\" data-name=\"register prompt text\" data-kid=\"3-2-1-9\">Chưa có tài khoản? <a href=\"#\" class=\"font-semibold text-[#FF2E93]\" data-name=\"register now link\" data-kid=\"3-2-1-9-1\">Đăng ký ngay</a></p>\n    </div>\n  </div>\n</div>",
